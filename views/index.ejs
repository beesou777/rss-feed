<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Medium RSS Aggregator</title>
  <link rel="stylesheet" href="../public/style.css">
</head>
<body>
  <h1 class="feed-main-title">Medium RSS Feed</h1>

  <% feeds.forEach(feed => { %>
   <div class="feed">
    <h2 class="feed-title"><%= feed.title %></h2>
    <ul class="feed-items">
      <% feed.item.forEach(item => { %>
        <li class="feed-item">
         <a href="<%= item.link %>">
          <div class="image-wrapper">
            <img class="feed-item-image" src="<%= item.image %>" alt="<%= item.title %>">
          </div>
         <div class="feed-item-info">
           <h3 class="feed-item-title"><%= item.title %></h3>
           <p class="feed-item-description"><%= item.description %></p>
          <p class="feed-item-date"><%= item.formattedDate %></p>
         </div>
         </a>
        </li>
      <% }); %>
    </ul>
   </div>
  <% }); %>
  
</body>
</html>
